load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "build",
    srcs = [
        "artifacts.go",
        "catalog.go",
        "log.go",
        "runner.go",
        "service.go",
        "source.go",
    ],
    importpath = "github.com/dan-stowell/justbuildit/internal/build",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "artifacts_test",
    srcs = ["artifacts_test.go"],
    deps = [":build"],
)

go_test(
    name = "service_test",
    srcs = ["service_test.go"],
    deps = [":build"],
)

go_test(
    name = "source_test",
    srcs = ["source_test.go"],
    deps = [":build"],
)
